{
  "id": "e7-guarantee-tracker",
  "name": "Guarantee Tracker",
  "kind": "web-app",
  "owner": "Head of Credit Guarantees",
  "steward": "Guarantee Operations Data Steward",
  "department": "Credit Guarantees",
  "purpose": "Lets guarantee officers follow the guarantees issued against SME loans: status, coverage, expiry and the SME behind each one, with a generated plain-language summary. Test asset: all data is fabricated.",
  "version": "1.0.0",
  "model": {
    "provider": "Google",
    "name": "gemini-2.5-flash",
    "region": "unknown",
    "trainingUse": "Free tier of the Gemini API: prompts may be used by the provider to improve its products. Only masked records are sent."
  },
  "subProcessors": [
    {
      "name": "Google Gemini API",
      "host": "generativelanguage.googleapis.com",
      "purpose": "Generates the guarantee summary from a masked record",
      "location": "Outside Qatar (provider-selected region)"
    },
    {
      "name": "Vercel",
      "host": "vercel.app",
      "purpose": "Hosts the application and its functions",
      "location": "Outside Qatar"
    },
    {
      "name": "Vercel Blob",
      "host": "blob.vercel-storage.com",
      "purpose": "Stores the Assurance Gate policy document",
      "location": "Outside Qatar"
    }
  ],
  "data": [
    {
      "dataset": "guarantees",
      "fields": ["guarantee_id", "application_id", "sme_id", "guarantor_name", "guarantor_qid", "aux_code", "amount", "coverage_pct", "currency", "status", "issued_at", "expires_at"],
      "classification": { "guarantor_name": "Confidential", "guarantor_qid": "Restricted", "aux_code": "Restricted" },
      "purpose": "Tracking guarantees through their life",
      "retentionDays": 365
    },
    {
      "dataset": "smes",
      "fields": ["sme_id", "cr_number", "name_en", "name_ar", "sector_code", "region_code", "owner_name", "owner_qid", "owner_phone", "owner_email", "iban", "ref2", "notes"],
      "classification": {
        "owner_name": "Confidential",
        "owner_qid": "Restricted",
        "owner_phone": "Restricted",
        "owner_email": "Restricted",
        "iban": "Restricted",
        "ref2": "Restricted",
        "notes": "Restricted"
      },
      "purpose": "Identifying the SME a guarantee covers",
      "retentionDays": 365
    },
    { "dataset": "sectors", "fields": ["code", "name_en", "name_ar"], "classification": {}, "purpose": "Reference list", "retentionDays": 365 },
    { "dataset": "regions", "fields": ["code", "name_en", "name_ar"], "classification": {}, "purpose": "Reference list", "retentionDays": 365 }
  ],
  "lineage": [
    { "from": "shared-data/guarantees.json", "to": "list, record and report screens", "transform": "join with smes on sme_id, masking by role" },
    { "from": "shared-data/smes.json", "to": "list, record and report screens", "transform": "join on sme_id, masking by role" },
    { "from": "record (masked)", "to": "AI summary", "transform": "generation by the declared model, masked again by role" }
  ],
  "roles": [
    { "role": "officer", "routes": ["/", "/record/:id"] },
    { "role": "manager", "routes": ["/", "/record/:id", "/reports"] },
    { "role": "admin", "routes": ["/", "/record/:id", "/reports", "/admin"] }
  ],
  "retention": { "conversationsDays": 30, "logsDays": 30 },
  "incident": { "contact": "Guarantee Operations Duty Manager", "notifyWithinHours": 24, "procedureUrl": "/docs/incident.md" },
  "languages": ["en", "ar"],
  "gate": { "installed": true, "version": "1.0.0" }
}
